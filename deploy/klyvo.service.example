[Unit]
Description=Klyvo Next.js storefront
After=network.target

[Service]
Type=simple
User=klyvo
Group=klyvo
WorkingDirectory=/srv/apps/klyvo/current
EnvironmentFile=/etc/klyvo/env
Environment=NODE_ENV=production
Environment=HOSTNAME=127.0.0.1
Environment=PORT=3010
ExecStart=/usr/bin/node server.js
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/srv/apps/klyvo

[Install]
WantedBy=multi-user.target
